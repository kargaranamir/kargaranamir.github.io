<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != '/' %}
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        {% comment %}
          Local override of al_folio_core's header.liquid (v1.0.15): the navbar shows only
          the main profiles, as on the old site. The full list is on the /social/ page.
        {% endcomment %}
        {% assign s = site.data.socials %}
        <style>
          .navbar-brand.social .hf-icon svg path {
            fill: var(--global-text-color);
            transition: fill 0.2s ease-in-out;
          }
          .navbar-brand.social .hf-icon:hover svg path {
            fill: var(--global-theme-color);
          }
        </style>
        <div class="navbar-brand social">
          {% if s.email -%}
            <a href="mailto:{{ s.email | encode_email }}" title="Email"><i class="fa-solid fa-envelope"></i></a>
          {%- endif %}
          {% if s.scholar_userid -%}
            <a href="https://scholar.google.com/citations?user={{ s.scholar_userid }}" title="Google Scholar"><i class="ai ai-google-scholar"></i></a>
          {%- endif %}
          {% if s.github_username -%}
            <a href="https://github.com/{{ s.github_username }}" title="GitHub"><i class="fa-brands fa-github"></i></a>
          {%- endif %}
          {% if s.linkedin_username -%}
            <a href="https://www.linkedin.com/in/{{ s.linkedin_username }}" title="LinkedIn"><i class="fa-brands fa-linkedin"></i></a>
          {%- endif %}
          {% if s.x_username -%}
            <a href="https://twitter.com/{{ s.x_username }}" title="X"><i class="fa-brands fa-x-twitter"></i></a>
          {%- endif %}
          {% if s.huggingface -%}
            <a href="{{ s.huggingface.url }}" title="Hugging Face" class="hf-icon">
              <svg viewBox="0 0 24 24" role="img" aria-label="Hugging Face">
