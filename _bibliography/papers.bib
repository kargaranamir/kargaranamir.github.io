  preview = {whoflips.png},
  bibtex_show = {true},
  arxiv = {2606.16011},
  code = {https://github.com/nafisenik/WhoFlips},
  abstract = {Accuracy benchmarks check whether LLMs reach the right answer, not whether they keep it. We challenge correct answers with a coherent argument for a wrong option and measure how often models flip. Across seven frontier models and 57 MMLU subjects, flip rates range from 17.5\% to 97.3\%; self-attribution raises them further, and our cross-model MaxFlip benchmark amplifies flips by up to 23.6pp.}
}

